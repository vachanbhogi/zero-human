# ==============================================================================
# Tack (Zero Human) Environment Configuration
# Copy this file to .env.local for local development. Never commit .env.local!
# ==============================================================================

# --- Supabase Database & Auth ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here
# Supabase service-role secret key (server-side only, never NEXT_PUBLIC_*).
# Enables SupabaseOrdersServer (lib/orders-factory.ts); see docs/APPLY-SCHEMA.md.
SUPABASE_SECRET_KEY=your_service_role_secret_key_here

# --- AI & Intelligence Engine ---
# Fast Llama 3.3 70B inference for site scanning & agent analysis
GROQ_API_KEY=gsk_your_groq_api_key_here

# Bright Data Web Unlocker proxy (server-side only)
BRIGHT_DATA_API_KEY=your_bright_data_api_key_here
BRIGHT_DATA_ZONE=tack

# --- Stripe Payments ---
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
NEXT_PUBLIC_STRIPE_PAYMENT_LINK=https://buy.stripe.com/your_payment_link_here
STRIPE_PAYMENT_LINK_URL=https://buy.stripe.com/your_payment_link_here
STRIPE_PAYMENT_LINK_ID=plink_your_payment_link_id_here

# --- Multi-Agent Runner & Pipeline ---
# Shared secret required on the x-run-secret header for POST /api/run
RUN_SHARED_SECRET=your_random_32_byte_secret_here

# Active pipeline copy variant ("A" or "B")
PIPELINE_VARIANT=A

# --- Terac Human-in-the-Loop Network ---
TERAC_API_KEY=tk_your_terac_api_key_here
TERAC_STUDY_ID=your_terac_study_id_here
TERAC_STUDY_METRIC=preference
TERAC_STUDY_A_SCORE=4
TERAC_STUDY_B_SCORE=2
